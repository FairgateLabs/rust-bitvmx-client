{
    "rust-analyzer.check.overrideCommand": [
        "cargo",
        "check",
        "--locked",
        "--workspace",
        "--all-targets",
        "--message-format=json"
    ],
    "rust-analyzer.cargo.buildScripts.overrideCommand": [
        "cargo",
        "check",
        "--locked",
        "--workspace",
        "--all-targets",
        "--message-format=json"
    ]
}